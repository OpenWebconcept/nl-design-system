{
  "name": "@openwebconcept/storybook",
  "author": "Community for NL Design System",
  "description": "Storybook based on the NL Design System architecture",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:openwebconcept/nl-design-system.git",
    "directory": "packages/storybook"
  },
  "scripts": {
    "build": "storybook build --output-dir dist/ --config-dir config/",
    "clean": "rimraf dist/",
    "lint-build": "tsc --noEmit --project tsconfig.json",
    "storybook": "storybook dev --config-dir config/ --port 6006"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@etchteam/storybook-addon-status": "5.0.0",
    "@openwebconcept/assets": "workspace:*",
    "@openwebconcept/design-tokens": "workspace:*",
    "@openwebconcept/components-css": "workspace:*",
    "@openwebconcept/theme-owc": "workspace:*",
    "@openwebconcept/theme-barendrecht": "workspace:*",
    "@openwebconcept/theme-de-fryske-marren": "workspace:*",
    "@openwebconcept/theme-gouda": "workspace:*",
    "@openwebconcept/theme-hoeksche-waard": "workspace:*",
    "@openwebconcept/theme-noordwijk": "workspace:*",
    "@openwebconcept/web-components-react": "workspace:*",
    "@openwebconcept/web-components-stencil": "workspace:*",
    "@storybook/addon-a11y": "8.6.16",
    "@storybook/addon-actions": "8.6.16",
    "@storybook/addon-docs": "8.6.16",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.16",
    "@storybook/addon-themes": "8.6.16",
    "@storybook/addon-viewport": "8.6.16",
    "@storybook/manager-api": "8.6.18",
    "@storybook/react": "8.6.16",
    "@storybook/react-vite": "8.6.16",
    "@storybook/theming": "8.6.18",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@whitespace/storybook-addon-html": "6.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-syntax-highlighter": "15.6.6",
    "rimraf": "6.1.3",
    "storybook": "8.6.17",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  },
  "dependencies": {
    "@gemeente-denhaag/process-steps": "4.3.0",
    "@nl-design-system-candidate/button-css": "1.1.0"
  }
}
