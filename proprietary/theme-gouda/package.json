{
  "name": "@openwebconcept/theme-gouda",
  "version": "1.0.0",
  "author": "Community for NL Design System",
  "description": "Design tokens for Gouda theme",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "nl-design-system",
    "design-tokens",
    "gouda"
  ],
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:openwebconcept/nl-design-system.git",
    "directory": "proprietary/theme-gouda"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "build": "pnpm run --sequential '/^build:.+$/'",
    "build:clean": "pnpm run clean",
    "build:style-dictionary": "style-dictionary build --config ./style-dictionary.config.json",
    "build:index": "sass src/index.scss dist/index.css --no-source-map",
    "watch": "pnpm run '/^watch:.+$/'",
    "watch:style-dictionary": "chokidar --follow-symlinks --initial --command 'pnpm run build' 'src/**/*.tokens.json'"
  },
  "dependencies": {
    "@fontsource/ubuntu": "5.2.8"
  },
  "peerDependencies": {
    "@openwebconcept/design-tokens": "1.0.0"
  },
  "devDependencies": {
    "chokidar-cli": "3.0.0",
    "rimraf": "6.1.3",
    "sass": "1.101.0",
    "style-dictionary": "5.5.0"
  }
}
