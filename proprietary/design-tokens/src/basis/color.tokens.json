{
  "basis": {
    "color": {
      "default": {
        "bg-default": {
          "$value": "#e5e7eb"
        },
        "bg-subtle": {
          "$value": "#f3f4f6"
        },
        "border-default": {
          "$value": "#d1d5dc"
        },
        "color-default": {
          "$value": "#364153"
        },
        "color-document": {
          "$value": "#000000"
        },
        "color-hover": {
          "$value": "#1e2939"
        },
        "color-subtle": {
          "$value": "#6a7282"
        }
      },
      "disabled": {
