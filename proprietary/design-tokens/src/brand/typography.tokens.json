{
  "owc": {
    "typography": {
      "font-family": {
        "sans": {
          "$value": "system-ui, sans-serif"
        }
      },
      "font-size": {
        "sm": {
          "$value": "clamp(0.8255rem, 0.7822rem + 0.1845vw, 0.9091rem)"
        },
        "base": {
          "$value": "clamp(0.875rem, 0.8103rem + 0.2759vw, 1rem)"
        },
        "lg": {
          "$value": "clamp(0.9275rem, 0.8383rem + 0.3807vw, 1.1rem)"
        },
        "xl": {
          "$value": "max(clamp(0.9832rem, 0.8658rem + 0.5006vw, 1.21rem), calc({owc.typography.font-size.lg} * 1.05))"
        },
        "2xl": {
          "$value": "max(clamp(1.0421rem, 0.8927rem + 0.6375vw, 1.331rem), calc({owc.typography.font-size.xl} * 1.05))"
        },
        "3xl": {
          "$value": "max(clamp(1.1709rem, 0.9436rem + 0.9701vw, 1.6105rem), calc({owc.typography.font-size.2xl} * 1.05))"
        },
        "4xl": {
          "$value": "max(clamp(1.567rem, 1.0359rem + 2.2659vw, 2.5937rem), calc({owc.typography.font-size.3xl} * 1.05))"
        }
      },
      "line-height": {
        "base": {
          "$value": "1.75"
        }
      }
    }
  }
}
