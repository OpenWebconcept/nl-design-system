{
  "denhaag": {
    "button": {
      "border-radius": {
        "$value": "{owc.button.border-radius}"
      },
      "border-width": {
        "$value": "{owc.button.border-width}"
      },
      "font-family": {
        "$value": "{basis.text.font-family.default}"
      },
      "font-size": {
        "$value": "{owc.button.font-size}"
      },
      "font-weight": {
        "$value": "{owc.button.font-weight}"
      },
      "gap": {
        "$value": "8px"
      },
      "icon-only-height": {
        "$value": "2.6875rem"
      },
      "icon-only-icon-height": {
        "$value": "20px"
      },
      "large-size-line-height": {
        "$value": "1.75"
      },
      "padding-block": {
        "$value": "{owc.button.padding-block}"
      },
      "padding-inline": {
        "$value": "{owc.button.padding-inline}"
      },
      "primary-action": {
        "background-color": {
          "$value": "{owc.color.primary}"
        },
        "color": {
          "$value": "#ffffff"
        },
        "disabled-background-color": {
          "$value": "{basis.color.disabled.bg-default}"
        },
        "disabled-color": {
          "$value": "{basis.color.disabled.color-default}"
        },
        "hover-background-color": {
          "$value": "color-mix(in srgb, {owc.color.primary}, #000000 25%)"
        },
        "hover-color": {
          "$value": "#ffffff"
        }
      },
      "secondary-action": {
        "background-color": {
          "$value": "#ffffff"
        },
        "border-color": {
          "$value": "{owc.color.primary}"
        },
        "color": {
          "$value": "{owc.color.primary}"
        },
        "disabled-background-color": {
          "$value": "#ffffff"
        },
        "disabled-border-color": {
          "$value": "{basis.color.disabled.border-default}"
        },
        "disabled-color": {
          "$value": "{basis.color.disabled.color-default}"
        },
        "hover-background-color": {
          "$value": "color-mix(in srgb, {owc.color.primary} 10%, #ffffff)"
        },
        "hover-border-color": {
          "$value": "color-mix(in srgb, {owc.color.primary}, #000000 25%)"
        },
        "hover-color": {
          "$value": "color-mix(in srgb, {owc.color.primary}, #000000 25%)"
        }
      }
    },
    "color": {
      "red-500": {
        "$value": "{basis.color.negative.inverse-bg-default}"
      }
    }
  }
}
