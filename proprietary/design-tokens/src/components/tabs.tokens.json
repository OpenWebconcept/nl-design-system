{
  "denhaag": {
    "tabs": {
      "border-color": {
        "$value": "{basis.color.default.border-default}"
      },
      "border-style": {
        "$value": "solid"
      },
      "border-width": {
        "$value": "2px"
      },
      "tab": {
        "color": {
          "$value": "{basis.color.default.color-default}"
        },
        "cursor": {
          "$value": "pointer"
        },
        "focus-color": {
          "$value": "{owc.color.primary}"
        },
        "font-family": {
          "$value": "{basis.text.font-family.default}"
        },
        "font-size": {
          "$value": "{basis.text.font-size.md}"
        },
        "font-weight": {
          "$value": "500"
        },
        "gap": {
          "$value": "8px"
        },
        "hover-color": {
          "$value": "{basis.color.default.color-hover}"
        },
        "indicator": {
          "border-color": {
            "$value": "{owc.color.primary}"
          },
          "border-width": {
            "$value": "2px"
          },
          "bottom": {
            "$value": "0"
          }
        },
        "line-height": {
          "$value": "1.5"
        },
        "outline": {
          "$value": "{basis.focus.outline-width} {basis.focus.outline-style} {basis.focus.outline-color}"
        },
        "padding-block-end": {
          "$value": "0.75rem"
        },
        "padding-block-start": {
          "$value": "0.75rem"
        },
        "padding-inline-end": {
          "$value": "1rem"
        },
        "padding-inline-start": {
          "$value": "1rem"
        },
        "panel": {
          "outline": {
            "$value": "{basis.focus.outline-width} {basis.focus.outline-style} {basis.focus.outline-color}"
          },
          "padding-block-end": {
            "$value": "0"
          },
          "padding-block-start": {
            "$value": "16px"
          },
          "padding-inline-end": {
            "$value": "0"
          },
          "padding-inline-start": {
            "$value": "0"
          }
        },
        "selected-color": {
          "$value": "{owc.color.primary}"
        },
        "selected-font-weight": {
          "$value": "600"
        }
      },
      "width": {
        "$value": "100%"
      }
    }
  }
}
