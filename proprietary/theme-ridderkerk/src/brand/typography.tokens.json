{
  "owc": {
    "typography": {
      "font-family": {
        "sans": {
          "$value": "\"Open Sans\", sans-serif"
        }
      },
      "font-size": {
        "sm": {
          "$value": "0.9rem"
        },
        "base": {
          "$value": "clamp(0.9rem, 0.8046rem + 0.4071vw, 1rem)"
        },
        "xl": {
          "$value": "1.1rem"
        }
      },
      "line-height": {
        "base": {
          "$value": "1.7"
        }
      }
    }
  }
}
